trigger1 = movehit
v = 34    
value = 1
ignorehitpause=1
persistent=0

[State 200, 1]
type = HitDef
p2facing = 1 
trigger1 = !time
hitonce = 1
attr = S, HT
damage = ceil(cond(fvar(11) *80 < 10, 10, fvar(11) * 100)), 10
hitflag = MAFD
guardflag = MA
