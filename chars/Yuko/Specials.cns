;---------------------------------------------------------------------------
;5S Zoltraak
[Statedef 1000]
type    = S
movetype= A
physics = S
poweradd= 0
ctrl = 0
anim = 1000
sprpriority = 2

;=====SCALING SHIT==================
[State Stun Scaling]
type = VarAdd
trigger1 = movehit
fv = 25  
value = 1
ignorehitpause = 1
persistent = 0

ignorehitpause = 1
[State Damage Scaling]
type = VarAdd
trigger1 = movehit=1
fv =13     ;fv = 
value = 1
persistent = 0
;==================================


[State 0, Explod]
type = Explod
trigger1 =animelem=2
anim = 1010
ID = 1010
pos = 0,0
postype = p1  ;p2,front,back,left,right
bindtime = -1
removetime = -2
scale =.84,.84
sprpriority = 4
ownpal = 1
removeonchangestate=1
ignorehitpause =1 

[State 0, VelSet]
type = VelSet
trigger1 =animelem=2
x = -8
ignorehitpause = 1

[State 200, 1]
type = HitDef 
p2facing = 1
trigger1 = movecontact = 0
attr = A, SP
animtype  = Hard
air.animtype = back
damage = ceil(cond(fvar(11) * 70 < 7, 7, fvar(11) * 70)), 0
hitflag = MAFD
guardflag = MA
pausetime = 10,10
sparkno = 2
sparkxy = -15,-45
guardsound =S300, 2
ground.type = trip
ground.slidetime = 12
ground.hittime  = ceil(cond(fvar(15) *20 < 9, 9, fvar(15) * 20))
air.hittime  = ceil(cond(fvar(15) *30 < 15, 15, fvar(15) * 30))
down.hittime = ceil(cond(fvar(15) *30 < 15, 15, fvar(15) * 30))
ground.velocity = -7,-4
air.velocity = -7,-4
envshake.time = 12
envshake.freq = 90
envshake.ampl = 3
envshake.phase = 1
guard.hittime =15
guard.slidetime = 15
guard.ctrltime = 15
guard.velocity = -6
forcenofall = 1
getpower = (100)*(cond(var(var(2)) = 1, 1, 1)) 
p2stateno = 1225
ground.cornerpush.veloff = -8

[State 210, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

