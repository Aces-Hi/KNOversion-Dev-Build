[Info]
name = "HEAVEN"
round1def = stages/Heaven.def
round2def = stages/Heaven2.def
round3def = stages/Heaven3.def

[Constants]

StaticShadow = 1
DynamicShadow = 0 
ShadowMulValue = -0.1
ShadowRComponent = -17
ShadowGComponent = -10
ShadowBComponent = -15


[camera]
startx 	= 0
starty 	= 0
boundleft 	= -189
boundright 	= 189
boundhigh = -20
boundlow = 0
verticalfollow = .1
tension = 100
zoomin=1
zoomout=.9
autocenter=1

;--------------------------------------------------------
[playerinfo]
p1startx = -70          ;starting x coordinates
p1starty = 0            ;starting y coordinates
p1startz = 0            ;starting z coordinates
p1facing = 1            ;direction player faces: 1=right, -1=left

p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

leftbound  = -1000 ;left bound (x-movement)
rightbound =  1000 ;right bound
topbound  =  0   ;Top bound (z-movement)
botbound  =  0    ;Bottom bound

;--------------------------------------------------------
[scaling]
topz     = 0       ;top z-coordinate for scaling
botz     = 50      ;bottom z-coordinate for scaling
topscale = 1       ;scale to use at top
botscale = 1.2     ;scale to use at bottom

;--------------------------------------------------------
[bound]
screenleft = 15    ;dist from left of screen that player can move to
screenright = 15   ;right edge

;--------------------------------------------------------
[stageinfo]
 
zoffset = 200
autoturn = 1
resetbg = 0
;--------------------------------------------------------
[shadow]
intensity = 60
color = 20,20,20
fade.range = 0,-50
yscale = 0.3


