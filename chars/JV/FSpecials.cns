ground.hittime  = 30
ground.velocity = -8,-3
air.velocity = -8,1
air.hittime = 30
envshake.time = 7
fall = 1
air.fall=1
fall.yvelocity = 0
guard.slidetime = 9
guard.hittime = 9
guard.ctrltime =9
getpower = (100)*(cond(var(var(2)) = 1, 1, .5)) 

[State 0, VelAdd]
type = veladd
trigger1 = animelem = 1 || animelem = 4
x = vel x + 6
[State 0, VelAdd]
type = velset
trigger1 = animelem = 5
x = vel x + 6

[State End, Transfer to Idle]
type = ChangeState
trigger1 = animtime = 0
ctrl 	= 1
value 	= 0



