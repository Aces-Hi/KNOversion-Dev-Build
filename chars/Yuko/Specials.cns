;---------------------------------------------------------------------------
;5S Zoltraak
[Statedef 1000]
type    = S
movetype= A
physics = N
poweradd= 0
ctrl = 0
anim = 1000
sprpriority = 2

;=====SCALING SHIT==================
[State Stun Scaling]
type = VarAdd
trigger1 = movehit
fv = 25  
value = 1
ignorehitpause = 1
persistent = 0

ignorehitpause = 1
[State Damage Scaling]
type = VarAdd
trigger1 = movehit=1
fv =13     ;fv = 
value = 1
persistent = 0
;==================================

[State 0, VelMul]
type = VelMul
trigger1 = animelemtime(10)<0
x = .9
y = .9

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = time=0&&pos y < 0
value = 1050

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = animelem=10&&anim!=1050&&pos y < 0
value = 1050
elem=10
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = animelem=10&&anim!=1000&&pos y >= 0
value = 1000
elem=10

;because why wouldn't you want to make it move
[State 0, Veladd]
type = VelMul
triggerall = animelemtime(8)<0
triggerall=map(Imagination)>=800
triggerall=pos y <=-80
trigger1 = command != "holddown"
y = .95
persistent=1

[State 0, Veladd]
type = VelSet
triggerall = animelemtime(8)<0
triggerall=map(Imagination)>=800
trigger1=pos y >-80
trigger1=vel y <-3
y = -3
persistent=1
[State 0, Veladd]
type = Veladd
triggerall = animelemtime(8)<0
triggerall=map(Imagination)>=800
trigger1=vel y < 3
trigger1=pos y >-80
trigger1 = command = "holdup"
y = -1.25
persistent=1
[State 0, Veladd]
type = VelSet
triggerall = animelemtime(8)<0
triggerall=map(Imagination)>=800
trigger1=vel y > 3
y =3
persistent=1
[State 0, Veladd]
type = Veladd
triggerall = animelemtime(8)<0
triggerall=map(Imagination)>=800
trigger1=vel y < 3
trigger1 = pos y <-5
trigger1 = command = "holddown"
y = 1.25
persistent=1

[State 0, Velset]
type = Velset
triggerall = animelemtime(8)<0
trigger1 = vel x > 3
trigger1 = command = "holdfwd"
x = 3
[State 0, Veladd]
type = Veladd
triggerall = animelemtime(8)<0
triggerall=map(Imagination)>=800
trigger1 = vel x < 3
trigger1 = command = "holdfwd"
x = 1.25
persistent=1
[State 0, Velset]
type = Velset
triggerall = animelemtime(8)<0
trigger1 = vel x < -3
trigger1 = command = "holdback"
x = -3
[State 0, Veladd]
type = Veladd
triggerall = animelemtime(8)<0
triggerall=map(Imagination)>=800
trigger1 = vel x > -3
trigger1 = command = "holdback"
x = -1.25
persistent=1


[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = pos y < 0 && animelemtime(10)<0
statetype = A       ;S,A,C,L
movetype = A        ;I,A,H
physics = N         ;A,C,S,N
ignorehitpause = 1
persistent = 1
[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = pos y >= 0 && animelemtime(10)<0
statetype = S       ;S,A,C,L
movetype = A        ;I,A,H
physics = N         ;A,C,S,N
ignorehitpause = 1
persistent = 1

[State 0, PosSet]
type = PosSet
trigger1 = pos y > 0 
y = 0
ignorehitpause = 1
persistent = 1
[State 0, Velset]
type = Velset
trigger1 = pos y > 0
y = 0
ignorehitpause=1
persistent = 1

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = pos y < 0 && animelemtime(10)>=0
statetype = A       ;S,A,C,L
movetype = A        ;I,A,H
physics = A         ;A,C,S,N
ignorehitpause = 1
persistent = 1
[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = pos y >= 0 && animelemtime(10)>=0
statetype = S       ;S,A,C,L
movetype = A        ;I,A,H
physics = S         ;A,C,S,N
ignorehitpause = 1
persistent = 1

[State 0, Explod]
type = Explod
trigger1 =animelem=8
anim = 1010
ID = 1010
pos = 0,0
postype = p1  ;p2,front,back,left,right
bindtime = -1
removetime = -2
scale =.84,.84
sprpriority = 4
ownpal = 1
removeonchangestate=1
ignorehitpause =1 

[State 0, VelSet]
type = VelAdd
trigger1 =animelem=8&&map(Imagination)<800
x = -8
ignorehitpause = 1

[State 200, 1]
type = HitDef 
p2facing = 1
trigger1 = movecontact = 0
attr = A, SP
animtype  = Hard
air.animtype = back
damage = ceil(cond(fvar(11) * 80 < 8, 8, fvar(11) * 80)), 10
hitflag = MAFD
guardflag = MA
pausetime = 10,10
sparkno = 2
sparkxy = -15,-45
guardsound =S300, 2
ground.type = trip
ground.slidetime = 12
ground.hittime  = ceil(cond(fvar(15) *20 < 9, 9, fvar(15) * 20))
air.hittime  = ceil(cond(fvar(15) *30 < 15, 15, fvar(15) * 30))
down.hittime = ceil(cond(fvar(15) *30 < 15, 15, fvar(15) * 30))
ground.velocity = -7,-4
air.velocity = -7,-4
envshake.time = 12
envshake.freq = 90
envshake.ampl = 3
envshake.phase = 1
guard.hittime =13
guard.slidetime = 13
guard.ctrltime = 13
guard.velocity = -6
forcenofall = 1
getpower = (100)*(cond(var(var(2)) = 1, 1, 1)) 
p2stateno = cond(map(zoltraak),5020,1225)
p2getp1state = cond(map(zoltraak),0,1)
ground.cornerpush.veloff = -8

[State 0, VarAdd]
type = MapAdd
trigger1 = movehit
map = "zoltraak"
value = 1
ignorehitpause = 1
persistent=0

[State 210, 5]
type = ChangeState
trigger1 = AnimTime = 0 && anim=1000
value = 0
ctrl = 1
[State 0, ChangeState]
type = ChangeState
trigger1 = pos y >= 0 && animelemtime(11)>=0 &&anim=1050
value = 52
ctrl = 1

[State Devil Chain]
type = ChangeState
trigger1 = movecontact
trigger1 = pos y >= 0
trigger1 = map(Imagination)>=800&&map(Momentum)>=1
triggerall = command = "b"
triggerall = command != "EX"
triggerall = command != "QCBs"
triggerall = command ="holdfwd"
triggerall = command !="holddown"
value = 2000
ctrl = 0
[State EX Devil Chain]
type = ChangeState
trigger1 = movecontact
trigger1 = pos y >= 0
trigger1 = map(Imagination)>=800&&map(Momentum)>=1
triggerall=map(EXLimiter5)=0
triggerall = command = "EX"
triggerall = command != "QCBs"
triggerall = command ="holdfwd"
triggerall = command !="holddown"
value = 2050
ctrl = 0

[State 0, CtrlSet]
type = CtrlSet
trigger1 = animelem=12&&combocount
value = 1

